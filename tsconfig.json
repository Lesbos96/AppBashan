{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@pricing": ["./supabase/functions/_shared/pricing/index.ts"],
      "@pricing/*": ["./supabase/functions/_shared/pricing/*"]
    }
  },
  "include": ["src", "supabase/functions/_shared/pricing", "supabase/functions/_shared/route", "supabase/functions/_shared/quote", "supabase/functions/_shared/http.ts"]
}
