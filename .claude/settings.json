{
  "model": "sonnet",
  "effortLevel": "medium",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|mcp__.*",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"], "onFailure": "block" }
        ]
      }
    ],
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session.mjs"] }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session.mjs"] }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session.mjs"] }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session.mjs"] }] }]
  },
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./supabase/functions/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./supabase/functions/.env)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.*.local)",
      "Write(./.env.production)",
      "Write(./.env.development)",
      "Write(./supabase/functions/.env)",
      "Bash(sed:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(git stash:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git checkout --:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(npx supabase config push:*)",
      "Bash(supabase config push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(node -e:*)",
      "PowerShell(node --eval:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git add -A:*)",
      "PowerShell(git add .:*)",
