      "PowerShell(git clean:*)",
      "PowerShell(npx supabase config push:*)",
      "PowerShell(supabase config push:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "Agent(general-purpose)",
      "Agent(claude)",
      "mcp__d7859db5-7e7e-4e6b-a9d5-ae276b32608a",
      "Edit(./docs/proof/**)",
      "Edit(./docs/freigaben/**)"
    ],
    "ask": [
      "Bash(npm run db:push:*)",
      "Bash(npx supabase db:*)",
      "Bash(supabase db:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(git push:*)",
