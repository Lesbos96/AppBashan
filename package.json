{
  "name": "movenow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "deno": "^2.9.6",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/scan-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --project unit",
    "check": "npm run lint && npm run typecheck && npm run check:deno && vitest run --project unit --reporter=default --reporter=json --outputFile=tmp/reports/vitest-unit.json",
    "test:rls": "dotenv -e .env.local -- vitest run --project rls --reporter=default --reporter=json --outputFile=tmp/reports/vitest-rls.json",
    "test:e2e": "playwright test --project=e2e",
    "shots": "playwright test --project=shots-390-light --project=shots-390-dark",
    "shots:all": "playwright test tests/shots",
    "env:check": "dotenv -e .env.local -- node scripts/env-check.mjs",
    "svg:extract": "node scripts/extract-svg.mjs",
    "fixtures:pricing": "node scripts/gen-golden.mjs",
    "geo:import": "dotenv -e .env.local -- node scripts/import-boundaries.mjs",
    "db:link": "dotenv -e .env.local -- node scripts/db-link.mjs",
    "db:push": "dotenv -e .env.local -- supabase db push --linked --include-seed --yes",
    "db:types": "dotenv -e .env.local -- supabase gen types typescript --linked --schema public > supabase/functions/_shared/database.types.ts",
    "check:deno": "deno check supabase/functions/_shared/pricing/index.ts supabase/functions/route/index.ts supabase/functions/quote/index.ts tests/unit/golden-deno.ts tests/unit/money-deno.ts && deno run --allow-read tests/unit/golden-deno.ts && deno run tests/unit/money-deno.ts"
  }
}
