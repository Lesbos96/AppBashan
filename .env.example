# Namen der Zugangsdaten, ohne Werte. Werte stehen nur in .env.local.
# App (landen im Build, öffentlich)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Turnstile Site Key (öffentlich wie der Publishable Key). Dev: der Cloudflare-Testschlüssel (immer gültig); Produktion: der echte Key (docs/GOLIVE.md)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Nur CLI und Tests, nie in der App
# Turnstile Secret: Dev der Cloudflare-Testsecret (immer gültig); Produktion das echte Secret. Steht zusätzlich als Function-Secret (route) und im Auth-Dashboard
TURNSTILE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=
# Aufräumen der Foto-Dateien (Function-Secret und Vault, einmalig per npm run setup:photo-cleanup)
CLEANUP_SECRET=
# Routing-Anbieter (HeiGIT/openrouteservice); wird als Function-Secret gesetzt, nie in der App
ORS_API_KEY=
